{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ultrabar",
  "version": "0.0.4",
  "identifier": "dev.hotarubi.ultrabar",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ultrabar",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#111113",
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMjM5NTYyOTc3MUEzMDgKUldRSW8zR1hZcFVqL0VGNm1xMzV1clE5UlRlRUZwY3dpS1RWRXRoZXRZQWxzR1ZxelRWdFRtTFoK",
      "endpoints": [
        "https://github.com/modrzew/ultrabar/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Configure your UltraBar X",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
